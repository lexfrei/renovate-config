{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate preset for lexfrei repositories. Extend via { \"extends\": [\"github>lexfrei/renovate-config\"] }.",
  "extends": [
    "config:recommended",
    "docker:enableMajor",
    ":semanticCommits",
    ":semanticCommitTypeAll(chore)",
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",
    "helpers:pinGitHubActionDigests",
    "security:gomodIndirectSecurityUpdates",
    ":enableVulnerabilityAlertsWithAdditionalLabel(security)"
  ],
  "labels": ["dependencies"],
  "osvVulnerabilityAlerts": true,
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "postUpdateOptions": ["gomodTidy", "gomodUpdateImportPaths"],
  "packageRules": [
    {
      "description": "Automerge minor, patch, pin and digest updates",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest"],
      "automerge": true
    },
    {
      "description": "Automerge all GitHub Actions updates including major",
      "matchManagers": ["github-actions"],
      "automerge": true
    },
    {
      "description": "Let Renovate bump the go directive in go.mod (needs GOTOOLCHAIN=auto or a matching setup-go in CI)",
      "matchManagers": ["gomod"],
      "matchDepNames": ["go"],
      "matchDepTypes": ["golang"],
      "rangeStrategy": "bump"
    },
    {
      "description": "Keep controller-runtime in lockstep with the Kubernetes libraries (a split bump breaks compilation: controller-runtime vX needs a matching client-go)",
      "groupName": "kubernetes",
      "matchManagers": ["gomod"],
      "matchPackageNames": ["sigs.k8s.io/controller-runtime", "k8s.io/**"]
    }
  ],
  "customManagers": [
    {
      "description": "Bump tool versions annotated with a '# renovate:' comment in workflows and the Makefile (golangci-lint, go, templ, ...)",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.ya?ml$/",
        "/^Makefile$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?.*\\n.*?[\"']?(?<currentValue>v?\\d+\\.\\d+\\.\\d+)[\"']?"
      ]
    },
    {
      "description": "Bump pinned apk packages annotated with a '# renovate: datasource=repology depName=alpine_<ver>/<pkg>' comment in Containerfiles and Dockerfiles",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Containerfile$/", "/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[\\w.-]+?=(?<currentValue>[\\w.-]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}loose{{/if}}"
    }
  ]
}
